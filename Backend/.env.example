# Copy this file to .env and adjust for your environment.
# app/config.py documents what each setting does.

ENVIRONMENT=development
DEBUG=true

# Comma-separated list, or "*" for local dev only. Never use "*" in production.
CORS_ORIGINS=*

# Path to trained .pkl models, relative to the backend/ working directory.
MODELS_DIR=../models

# Idle sessions are evicted after this many seconds of inactivity.
SESSION_TTL_SECONDS=1800
SESSION_CLEANUP_INTERVAL_SECONDS=300

# Rate limits, in slowapi's "<count>/<period>" format.
RATE_LIMIT_PREDICT=120/minute
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=5/minute

# Number of trusted reverse proxies in front of the application.
# 0 = ignore X-Forwarded-For and use socket client IP (safe default for local dev).
# Set to 1 behind a single proxy like Render/Railway so client IPs are extracted correctly.
TRUSTED_PROXY_COUNT=0

LOG_LEVEL=INFO

# --- Database ---
# SQLite by default - zero setup, creates fitvision.db in this folder.
# For PostgreSQL / Neon (staging/prod), provide a postgresql:// URL.
# The app automatically translates postgresql:// to postgresql+psycopg:// in database.py
# and enables pool_pre_ping=True and pool_recycle=300 to tolerate Neon idle compute suspension.
# Example:
#   DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./fitvision.db

# Separate database URL for running Postgres smoke tests (skipped when not set):
#   TEST_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-test-branch-pooler.region.aws.neon.tech/neondb?sslmode=require
# TEST_DATABASE_URL=

# --- Auth / JWT ---
# CHANGE THIS before any real deployment. Generate a strong random
# value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
