# Copy to .env.local for local dev or configure in Vercel Project Settings -> Environment Variables.
# NEVER commit .env.local or expose server-only secrets with NEXT_PUBLIC_.

# Required in Vercel production: public HTTPS URL of the Render FastAPI backend (no trailing slash).
BACKEND_URL=http://localhost:8000

# Canonical public origin(s) of the Next.js app for CSRF Origin checks (comma-separated if multiple).
# Example: https://fitvision.vercel.app
APP_ORIGIN=http://localhost:3000

# Optional server-to-server secret matching Backend BFF_PROXY_SECRET so Vercel BFF can
# forward Vercel's verified visitor IP (`x-vercel-forwarded-for`) for auth rate limiting.
BFF_PROXY_SECRET=
